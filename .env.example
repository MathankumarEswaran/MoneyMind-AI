# Docker Compose environment for the local production-like stack.
# Copy to .env (compose reads it automatically). Never commit real secrets.
#
# Generate independent secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

POSTGRES_USER=moneymind
POSTGRES_PASSWORD=change-me-in-real-environments
POSTGRES_DB=moneymind
POSTGRES_PORT=5432

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

API_PORT=4000
WEB_PORT=8080

# Browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Phase 2: database + auth ─────────────────────────────────────────────────
# Keep the password in this URL in sync with POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://moneymind:change-me-in-real-environments@postgres:5432/moneymind?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# The local Compose stack serves plain HTTP. Set true when terminating TLS.
COOKIE_SECURE=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
