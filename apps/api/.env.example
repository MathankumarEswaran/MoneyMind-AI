# ── MoneyMind API environment ────────────────────────────────────────────────
# Copy this file to apps/api/.env and adjust for your machine.
# Never commit real secrets.
#
# Generate independent 32+ character secrets, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Express trust proxy setting. Set true behind a load balancer/ingress.
TRUST_PROXY=false

# Request body cap (json + urlencoded).
BODY_LIMIT=1mb

# API rate limit (per IP, per window).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── PostgreSQL (required) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://moneymind:change-me@localhost:5432/moneymind?schema=public

# ── Authentication (required) ────────────────────────────────────────────────
# Both secrets must be at least 32 characters and must differ from each other.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret

# Access token lifetime (60–3600 seconds) and refresh session lifetime (days).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Refresh cookie. It is always HttpOnly, SameSite=Strict and scoped to /api/v1/auth.
COOKIE_NAME=mm_refresh
# COOKIE_DOMAIN=
# Defaults to true when NODE_ENV=production. Keep false for http://localhost.
# COOKIE_SECURE=false

# Auth-specific rate limiting (defaults: 20 requests per 15 minutes).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ── AI / LLM (Phase 4/5) ────────────────────────────────────────────────────
# Provider: openai | anthropic | ollama | none
AI_PROVIDER=openai
# Keep keys in environment variables only. Never expose to browser.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_TOOL_ITERATIONS=5
# Per-user AI rate limit (requests per window)
AI_RATE_LIMIT_WINDOW_MS=600000
AI_RATE_LIMIT_MAX=20
# Monthly AI token/cost guardrails (informational; enforced in code)
AI_MONTHLY_TOKEN_QUOTA=100000
AI_MONTHLY_COST_QUOTA_INR=1000.00

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=moneymind_documents

# Uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=application/pdf,text/plain,text/markdown,text/csv,application/csv
UPLOAD_STORAGE_DIR=./uploads
